# Supabase pooler (transaction mode) used by the running API.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
# Direct Supabase database connection, used only for Prisma migrations.
DIRECT_URL="postgresql://postgres:[password]@[db-host]:5432/postgres"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price IDs for each paid plan (from your test-mode Products/Prices).
STRIPE_PRICE_PRO="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# --- Redis (BullMQ job queue + rate limiting + caching) ---
REDIS_URL="rediss://default:[password]@[host]:6379"

# --- Rate limiting (two-tier, Redis-backed) ---
# Tier 1 (per-IP) and Tier 2 (per-workspace) limits per minute.
RATE_LIMIT_IP_PER_MINUTE="100"
RATE_LIMIT_WORKSPACE_PER_MINUTE="500"

# --- Logging ---
# pino level: trace | debug | info | warn | error
LOG_LEVEL="info"

# --- Auth ---
JWT_SECRET=""

# --- Stripe checkout integration ---
# Domain users are redirected back to after Stripe Checkout completes.
PUBLIC_BASE_URL="http://localhost:4000"

# --- Notifications ---
# Annas's n8n workflow endpoint; payment-success events are POSTed here.
N8N_WEBHOOK_URL=""
